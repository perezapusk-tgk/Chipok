{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "es2024"
    ],
    "strict": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "next"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
